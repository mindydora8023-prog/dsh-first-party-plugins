{
  "name": "dsh-plugin-session-meter",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "输入框下方显示当前是高峰还是低谷，并按 DeepSeek 官方价格估算本会话花费",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "icon.svg",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js && node --check lib/prices.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
